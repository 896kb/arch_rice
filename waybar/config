{
    "layer": "top",
    "position": "bottom",
    "height": 27,
    "margin-left": 48,
    "margin-right": 48,
    "margin-bottom": 5,
    
    "modules-left": ["hyprland/workspaces", "custom/cpu", "memory", "custom/gpu", "custom/vram"],
    "modules-center": ["custom/spotify", "custom/spotify-prev", "custom/spotify-play-pause", "custom/spotify-next"],
    "modules-right": ["disk", "backlight", "pulseaudio", "custom/network", "battery", "clock", "custom/power"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "all-outputs": true,
        "active-only": false
    },

    "custom/cpu": {
        "exec": "~/.config/waybar/scripts/cpu-info.sh",
        "return-type": "json",
        "interval": 2,
        "format": "󰻠 {}"
    },

    "memory": {
        "interval": 2,
        "format": "󰍛 {percentage}%",
        "tooltip-format": "RAM Usage\n{used:0.1f} / {total:0.1f} GB ({percentage}%)",
        "max-length": 10
    },

    "custom/gpu": {
        "exec": "~/.config/waybar/scripts/gpu-usage.sh",
        "return-type": "json",
        "interval": 2,
        "format": "󰢮 {}"
    },

    "custom/vram": {
        "exec": "~/.config/waybar/scripts/gpu-vram.sh",
        "return-type": "json",
        "interval": 2,
        "format": "󰞯 {}"
    },

    "disk": {
        "interval": 30,
        "format": "󰋊 {percentage_used}%",
        "path": "/"
    },

    "backlight": {
        "device": "intel_backlight",
        "format": "󰃞 {percent}%"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "custom/network": {
        "exec": "~/.config/waybar/scripts/network-info.sh",
        "return-type": "json",
        "interval": 5
    },

    "battery": {
        "bat": "BAT0",
        "adapter": "ADP0",
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "max-length": 25
    },

    "clock": {
        "interval": 5,
        "format": "󰥔 {:%H:%M}",
        "format-alt": "󰃭 {:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "{:%Y-%m-%d}"
    },

    "custom/power": {
        "format": "⏻",
        "on-click": "~/.config/waybar/scripts/powermenu.sh",
        "tooltip": false
    },

    "custom/spotify": {
        "exec": "~/.config/waybar/scripts/scroll_spotify_status.sh",
        "interval": 1,
        "format": "󰝚 {}",
        "max-length": 30,
        "on-click": "playerctl play-pause"
    },

    "custom/spotify-prev": {
        "format": "󰒮",
        "on-click": "playerctl previous",
        "tooltip": false
    },

    "custom/spotify-play-pause": {
        "exec": "~/.config/waybar/scripts/spotify-play-pause.sh",
        "interval": 1,
        "format": "{}",
        "on-click": "playerctl play-pause",
        "tooltip": false
    },

    "custom/spotify-next": {
        "format": "󰒭",
        "on-click": "playerctl next",
        "tooltip": false
    }
}

