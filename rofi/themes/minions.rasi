* {
  background-color: #00000000; 
  // border-color: #2e343f;
  text-color: #fff;
  // spacing: 0;
  // width: 100%;
  // height: 100%;
  // background-image: url("~/.config/rofi/themes/minion.svg", height);
}

minion {
  width: 400px;
  height: 400px;
  background-image: url("~/.config/rofi/themes/minion.svg", height);
}

window {
  orientation: horizontal;
  width: 800px;
  height: 400px;
  children: [minion, mainbox];
    // background-image: url("~/.config/rofi/themes/minion.png", height);
}

mainbox {
  width: 300px;
  height: 300px;
  background-color: #2e343faa;
  border-radius: 30px;
}

inputbar {
  border: 0 0 1px 0;
  children: [prompt,entry];
}

prompt {
  padding: 16px;
}

textbox {
  background-color: #2e343f;
  border: 0 0 1px 0;
  border-color: #282C33;
  padding: 8px 16px;
}

entry {
  padding: 16px;
}

listview {
  cycle: false;
  margin: 0 0 -1px 0;
  scrollbar: false;
}

element {
  padding: 16px;
}

element selected {
  background-color: #2e343f;
}