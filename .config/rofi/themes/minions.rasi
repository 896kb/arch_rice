* {
  background-color: #00000000;
  text-color: #000;
}

window {
  font: "Terminus Bold 15";
  orientation: horizontal;
  width: 800;
  height: 400;
  children: [minion, mainbox-wrapper];
    // background-image: url("~/.config/rofi/themes/minion.png", height);
}

mainbox-wrapper {
  orientation: vertical;
  spacing: 0;
  // vertical-align: 1.2;
  children: [mainbox];
}

minion {
  size: 200;
  background-image: url("~/.config/rofi/themes/minion.svg", height);
}

mainbox {
  background-color: #2196F3cc;
  border-radius: 30px;
}

wrapper-mode-switcher {
  background-color: #000;
  border-radius: 30px;
  padding: 30px;
  width: 300px;
  height: 50px;
  orientation: horizontal;
  children: [mode-switcher];
}

mode-switcher {
  width: 100%;
  horizontal-align: 1;
  position: center;
  border:  0px;
  spacing: 0px;
  expand: true;
}

inputbar-wrapper {

}

inputbar-icon {
  size: 20;
}

inputbar {
  border: 0 0 1px 0;
  children: [prompt,entry];
}

prompt {
  padding: 16px;
}

textbox {
  background-color: #2e343f;
  border: 0 0 1px 0;
  border-color: #282C33;
  padding: 8px 16px;
}

entry {
  padding: 16px;
}

listview {
  cycle: false;
  margin: 0 0 -1px 0;
  scrollbar: false;
}

element {
  padding: 16px;
}

element selected {
  background-color: #FFC006;
}