#!/usr/bin/env bash
# One pinch-dial step for air-gesturesd, with the rice's OSD.
#   air-gestures-dial volume up|down
#   air-gestures-dial brightness up|down
#   air-gestures-dial toggle            (swap the dial between volume and brightness)
OSD="$HOME/.local/bin/osd"
if [ "$1" = toggle ]; then
    air-gestures dial cycle >/dev/null || exit 1
    case "$(air-gestures status | sed -n 's/^dial: //p')" in
        brightness) "$OSD" dial "󰃠  Dial: brightness" ;;
        *)          "$OSD" dial "󰕾  Dial: volume" ;;
    esac
    exit 0
fi
case "$1 $2" in
    "volume up")   wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+ ;;
    "volume down") wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%- ;;
    "brightness up")   exec "$HOME/.local/bin/rocker" bright-up ;;
    "brightness down") exec "$HOME/.local/bin/rocker" bright-down ;;
    *) echo "usage: air-gestures-dial {volume|brightness} {up|down} | toggle" >&2; exit 2 ;;
esac
v=$(wpctl get-volume @DEFAULT_AUDIO_SINK@ | awk '{printf "%d", $2*100+0.5}')
"$OSD" vol "󰕾  ${v}%" "$v"
