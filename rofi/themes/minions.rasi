* {
  background-color: #282C3377; 
  border-color: #2e343f;
  text-color: #8ca0aa;
  spacing: 0;
  width: 100%;
  height: 100%;
}

window {
    padding: 20%;
    // background-image: url("~/.config/rofi/themes/minion.png", height);
}

mainbox {
    background-image: url("~/.config/rofi/themes/minion.png", height);
}

inputbar {
  border: 0 0 1px 0;
  children: [prompt,entry];
}

prompt {
  padding: 16px;
}

textbox {
  background-color: #2e343f;
  border: 0 0 1px 0;
  border-color: #282C33;
  padding: 8px 16px;
}

entry {
  padding: 16px;
}

listview {
  cycle: false;
  margin: 0 0 -1px 0;
  scrollbar: false;
}

element {
  padding: 16px;
}

element selected {
  background-color: #2e343f;
}