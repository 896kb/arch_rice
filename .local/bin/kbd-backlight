#!/usr/bin/env bash
# Keyboard backlight step + OSD.  Usage: kbd-backlight up|down
# Bound to the screen-brightness Fn keys (F7/F8 -> XF86MonBrightnessDown/Up),
# repurposed because screen brightness lives on the volume rocker now.
LED=/sys/class/leds/asus::kbd_backlight
case "${1:-}" in
    up)   asusctl leds next ;;
    down) asusctl leds prev ;;
    *) echo "usage: kbd-backlight {up|down}" >&2; exit 2 ;;
esac
cur=$(cat "$LED/brightness" 2>/dev/null || echo 0)
max=$(cat "$LED/max_brightness" 2>/dev/null || echo 3)
pct=$(( cur * 100 / max ))
"$HOME/.local/bin/osd" kbd "󰌌  Keyboard light ${cur}/${max}" "$pct"
